APP_NAME=Blood Donation API
DEBUG=True
ENV=development

HOST=0.0.0.0
PORT=8000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=blood_donation
DB_USER=####
DB_PASSWORD=####

# Full SQLAlchemy URL (used directly in FastAPI)
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/blood_donation


SECRET_KEY=supersecretkey_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ================================
# PASSWORD HASHING
# ================================
BCRYPT_ROUNDS=12

# ================================
# CORS (Frontend URL)
# ================================
FRONTEND_URL=http://localhost:3000

# ================================
# EMAIL (for alerts/notifications)
# ================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Blood Donation App <your_email@gmail.com>

# ================================
# SMS (Optional - Twilio)
# ================================
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+1234567890

# ================================
# GEOLOCATION / ALERT SETTINGS
# ================================
DEFAULT_ALERT_RADIUS_KM=10

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO